# 1. 카카오 지도 JavaScript 앱 키
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=your_kakao_javascript_key_here

# 2. Supabase 데이터베이스 설정
# - 브라우저/서버 공용 (조회용):
NEXT_PUBLIC_SUPABASE_URL=https://your_project_id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key
# - 서버 전용 비밀 키 (수집/쓰기용, NEXT_PUBLIC_ 접두사 없음, 브라우저 노출 금지):
#   Supabase Dashboard > Project Settings > API > service_role (secret) 키를 입력하세요.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 3. 공공데이터포털 API 설정
DATA_GO_KR_SDSC2_URL=https://apis.data.go.kr/B553077/api/open/sdsc2
DATA_GO_KR_GENERAL_RESTAURANTS_URL=https://apis.data.go.kr/1741000/general_restaurants
DATA_GO_KR_SERVICE_KEY=your_public_data_portal_service_key_here
